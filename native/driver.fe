// Generated alongside an exact snapshot of the table source. All wire integers
// are little-endian. Parsing, setup, verification, and output are outside timing.
use core::MemBuffer
use std::io::{Stdin, Stdout, read_to_end}
use std::native::cpu_clock_ticks

// Standard input, and the offset of its next unread byte.
struct Requests { bytes: MemBuffer, offset: usize }

// Whether another workload follows; reads its `@` marker.
fn next_workload() -> bool uses (input: mut Requests) {
    if input.offset == input.bytes.len() {
        return false
    }
    core::assert(input.bytes[input.offset] == 64)
    input.offset += 1
    true
}

fn read64() -> u64 uses (input: mut Requests) {
    let value = input.bytes.read_le<u64>(input.offset)
    input.offset += 8
    value
}

fn write64(_ value: u64) uses (output: mut MemBuffer) {
    let end = output.len()
    output.resize(end + 8)
    output.write_le(offset: end, value)
}

fn read256() -> u256 uses (input: mut Requests) {
    let a = read64() as u256
    let b = read64() as u256
    let c = read64() as u256
    let d = read64() as u256
    a | (b << 64) | (c << 128) | (d << 192)
}

fn write256(_ value: u256) uses (output: mut MemBuffer) {
    write64(value.downcast_truncate())
    write64((value >> 64).downcast_truncate())
    write64((value >> 128).downcast_truncate())
    write64((value >> 192).downcast_truncate())
}

#[inline(never)]
fn lookup_batch(
    table: SwissTable<u256, u256>,
    keys: [u256; 256],
    count: usize,
    rounds: u64,
) -> u64 {
    var index: usize = 0
    var checksum: u64 = 0
    var i: u64 = 0
    while i < rounds {
        let lookup = table.get(keys[index])
        let value: u64 = lookup.value.downcast_truncate()
        checksum = checksum.wrapping_add(value ^ (lookup.found as u64))
        // Runtime lookup results feed the next index. Workloads use even values
        // so the traversal visits every query in order, including misses.
        let step: usize = (value & 1).downcast_truncate()
        index = (index + 1 + step) % count
        i += 1
    }
    checksum
}

pub fn main() -> i32 uses (stdin: mut Stdin, out: mut Stdout) {
    var bytes = MemBuffer::empty()
    read_to_end(mut bytes)
    var input = Requests { bytes, offset: 0 }
    var output = MemBuffer::empty()
    with (mut input, mut output) {
        while next_workload() {
            var table = SwissTable<u256, u256>::empty()
            let operations = read64()
            var operation: u64 = 0
            while operation < operations {
                let kind = read64()
                let key = read256()
                let value = read256()
                __PROFILE_OPERATION__
                let success = if kind == 1 {
                    __INSERT__
                } else {
                    core::assert(kind == 2)
                    table.remove(key)
                }
                write64(success as u64)
                write64(table.len().downcast_unchecked())
                operation += 1
            }
            write64(table.deleted.downcast_unchecked())
            let count: usize = read64().downcast_unchecked()
            core::assert(count > 0 && count <= 256)
            var keys: [u256; 256] = [0; 256]
            var i: usize = 0
            while i < count {
                let key = read256()
                keys[i] = key
                __PROFILE_QUERY__
                let lookup = table.get(key)
                write64(lookup.found as u64)
                write256(lookup.value)
                let hash = key.hash()
                write64((hash as u256).downcast_truncate())
                write64(__START__.downcast_unchecked())
                write64(h2(hash) as u64)
                i += 1
            }
            let rounds = read64()
            core::assert(rounds > 0)
            let started = cpu_clock_ticks()
            let checksum = lookup_batch(table, keys, count, rounds)
            let ended = cpu_clock_ticks()
            core::assert(started >= 0 && ended >= started)
            write64((ended - started).downcast_unchecked())
            write64(checksum)
        }
    }
    print!(output)
    0
}
