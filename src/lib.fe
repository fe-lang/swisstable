use core::MemArray
use core::default::Default
use core::ops::{WrappingAdd, WrappingMul, WrappingSub}
use core::panics::PANIC_OUT_OF_MEMORY

const MIN_CAPACITY: usize = 16
const EMPTY: u8 = 255
const DELETED: u8 = 128

pub trait SwissKey {
    // Equal keys must have equal hashes; all key bits should affect the result.
    fn hash(self) -> u64
    fn equals(self, _ other: Self) -> bool
}

pub struct Lookup<V> { pub found: bool, pub value: V }

// One physical slot; `occupied` is false for empty and deleted slots.
pub struct Entry<K, V> { pub occupied: bool, pub key: K, pub value: V }

// Where a key is, or the slot inserting it takes.
struct Search { found: bool, slot: usize }

/// A hash table of `Copy` keys and values in memory it owns.
///
/// The slots, a power of two of them and at least 16, each have a control
/// byte: empty, deleted, or seven bits of its key's hash. A key is searched
/// for from the slot its hash selects, slot by slot, until an empty slot.
/// Entries and tombstones never fill more than half of the slots, which
/// keeps byte-by-byte probe runs short: past that, the table moves its
/// entries to fresh slots, doubling them unless the entries would fill at
/// most a quarter, which drops every tombstone. A move that cannot allocate
/// leaves the table as it was.
pub struct SwissTable<K, V> {
    ctrl: MemArray<u8>,
    keys: MemArray<K>,
    values: MemArray<V>,
    len: usize,
    deleted: usize,
}

const HASH_PRIME1: u64 = 0x9e3779b185ebca87
const HASH_PRIME2: u64 = 0xc2b2ae3d27d4eb4f
const HASH_PRIME3: u64 = 0x165667b19e3779f9
const HASH_PRIME4: u64 = 0x85ebca77c2b2ae63

// The high and low words of the 128-bit product, folded together.
fn folded_multiply(_ a: u64, _ b: u64) -> u64 {
    let product = (a as u128) * (b as u128)
    let low: u64 = product.downcast_truncate()
    let high: u64 = (product >> 64).downcast_truncate()
    low ^ high
}

// Folded multiplication, as in foldhash: each pair of the key's 64-bit
// limbs, offset by constants, multiplies into one lane, and the lanes
// multiply into the hash. Deterministic and non-cryptographic; this is not
// hash-flood protection.
pub fn hash_u256(_ key: u256) -> u64 {
    let limb0: u64 = key.downcast_truncate()
    let limb1: u64 = (key >> 64).downcast_truncate()
    let limb2: u64 = (key >> 128).downcast_truncate()
    let limb3: u64 = (key >> 192).downcast_truncate()
    let low = folded_multiply(limb0 ^ HASH_PRIME1, limb1 ^ HASH_PRIME2)
    let high = folded_multiply(limb2 ^ HASH_PRIME3, limb3 ^ HASH_PRIME4)
    folded_multiply(low ^ HASH_PRIME2, high ^ HASH_PRIME1)
}

// The fingerprint: the hash's top seven bits, which no slot index uses.
fn h2(_ hash: u64) -> u8 {
    (hash >> 57).downcast_unchecked()
}

// The slot a hash selects among `capacity` slots, a power of two. Starting
// each search there, rather than at the start of an aligned group, keeps keys
// whose slots share a group from piling into one run.
fn home_slot(_ hash: u64, _ capacity: usize) -> usize {
    let low: usize = hash.downcast_truncate()
    low & (capacity - 1)
}

// The most entries and tombstones `capacity` slots hold.
fn max_load(_ capacity: usize) -> usize {
    capacity / 2
}

// The first empty slot of `hash`'s search in `ctrl`.
fn empty_slot(_ ctrl: MemArray<u8>, _ hash: u64) -> usize {
    let capacity = ctrl.len()
    var slot = home_slot(hash, capacity)
    while ctrl[slot] != EMPTY {
        slot = (slot + 1) & (capacity - 1)
    }
    slot
}

impl SwissKey for u256 {
    fn hash(self) -> u64 {
        hash_u256(self)
    }

    fn equals(self, _ other: u256) -> bool {
        self == other
    }
}

impl<K, V> SwissTable<K, V> where K: SwissKey + Default + Copy, V: Default + Copy {
    /// An empty table, which has no slots until its first insertion.
    pub fn empty() -> Self {
        SwissTable {
            ctrl: MemArray::from_fn(0, |_| EMPTY),
            keys: MemArray::from_fn(0, |_| K::default()),
            values: MemArray::from_fn(0, |_| V::default()),
            len: 0,
            deleted: 0,
        }
    }
    pub fn len(self) -> usize {
        self.len
    }
    /// The number of physical slots, which `entry` reads.
    pub fn capacity(self) -> usize {
        self.ctrl.len()
    }
    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    fn search(self, _ key: K, _ hash: u64) -> Search {
        let capacity = self.ctrl.len()
        if capacity == 0 {
            return Search { found: false, slot: 0 }
        }
        let fingerprint = h2(hash)
        // The first tombstone the search passes, if any, takes an insertion.
        var tombstone = capacity
        var slot = home_slot(hash, capacity)
        while true {
            let ctrl = self.ctrl[slot]
            if ctrl == fingerprint && self.keys[slot].equals(key) {
                return Search { found: true, slot }
            }
            if ctrl == EMPTY {
                return Search { found: false, slot: if tombstone < capacity { tombstone } else { slot } }
            }
            if ctrl == DELETED && tombstone == capacity {
                tombstone = slot
            }
            slot = (slot + 1) & (capacity - 1)
        }
        Search { found: false, slot: 0 }
    }
    pub fn get(self, _ key: K) -> Lookup<V> {
        let search = self.search(key, key.hash())
        if search.found {
            return Lookup { found: true, value: self.values[search.slot] }
        }
        Lookup { found: false, value: V::default() }
    }
    pub fn contains(self, _ key: K) -> bool {
        self.search(key, key.hash()).found
    }
    /// The slot holding `key`, if any, for `value_at`. An insertion or
    /// reservation can move every entry; a removal moves no other.
    pub fn find(self, _ key: K) -> Option<usize> {
        let search = self.search(key, key.hash())
        if search.found { Option::Some(search.slot) } else { Option::None }
    }
    /// The value in a slot `find` returned, in place.
    pub fn value_at(mut? self, _ slot: usize) -> mut? V {
        mut? self.values[slot]
    }
    // Visit every live entry by reading slots `0..capacity()`; order is unspecified.
    pub fn entry(self, _ slot: usize) -> Entry<K, V> {
        let ctrl = self.ctrl[slot]
        if ctrl == EMPTY || ctrl == DELETED {
            return Entry { occupied: false, key: K::default(), value: V::default() }
        }
        Entry { occupied: true, key: self.keys[slot], value: self.values[slot] }
    }
    /// Inserts `key` with `value`, or updates its value. Reverts with
    /// `Panic(0x41)` when the table cannot grow.
    pub fn insert(mut self, _ key: K, _ value: V) {
        if !self.try_insert(key, value) {
            core::panic_code(PANIC_OUT_OF_MEMORY)
        }
    }
    /// As `insert`, but `false`, leaving the table as it was, when it cannot
    /// grow.
    pub fn try_insert(mut self, _ key: K, _ value: V) -> bool {
        match self.try_find_or_insert(key) {
            Option::Some(slot) => {
                self.values[slot] = value
                true
            },
            Option::None => false,
        }
    }
    /// The slot holding `key`, for `value_at`, after inserting it with the
    /// default value if it is absent, with one search; `None`, leaving the
    /// table as it was, when it cannot grow.
    pub fn try_find_or_insert(mut self, _ key: K) -> Option<usize> {
        let hash = key.hash()
        var search = self.search(key, hash)
        if search.found {
            return Option::Some(search.slot)
        }
        // An entry in a tombstone's slot adds no load.
        let reuses = self.ctrl.len() != 0 && self.ctrl[search.slot] == DELETED
        if !reuses && self.len + self.deleted >= max_load(self.ctrl.len()) {
            if !self.try_grow(self.len + 1) {
                return Option::None
            }
            search = self.search(key, hash)
        }
        if self.ctrl[search.slot] == DELETED {
            self.deleted -= 1
        }
        self.ctrl[search.slot] = h2(hash)
        self.keys[search.slot] = key
        self.values[search.slot] = V::default()
        self.len += 1
        Option::Some(search.slot)
    }
    /// Makes room for `additional` more entries without moving any; `false`,
    /// leaving the table as it was, when it cannot allocate.
    pub fn try_reserve(mut self, _ additional: usize) -> bool {
        let needed = self.len + additional
        needed + self.deleted <= max_load(self.ctrl.len()) || self.try_grow(needed)
    }
    /// Removes every entry, keeping the slots for later insertions.
    pub fn clear(mut self) {
        if self.len + self.deleted != 0 {
            self.ctrl.as_slice().fill(EMPTY)
            self.len = 0
            self.deleted = 0
        }
    }
    pub fn remove(mut self, _ key: K) -> bool {
        let search = self.search(key, key.hash())
        if !search.found {
            return false
        }
        self.len -= 1
        let capacity = self.ctrl.len()
        if self.len == 0 {
            // Nothing is left to find.
            self.ctrl.as_slice().fill(EMPTY)
            self.deleted = 0
            return true
        }
        // Every search reads slots in the same circular order, and ends at
        // an empty slot: one the next slot of which is empty ends every
        // search through it, and so do the tombstones before it.
        var slot = search.slot
        if self.ctrl[(slot + 1) & (capacity - 1)] != EMPTY {
            self.ctrl[slot] = DELETED
            self.deleted += 1
            return true
        }
        self.ctrl[slot] = EMPTY
        slot = (slot + capacity - 1) & (capacity - 1)
        while self.ctrl[slot] == DELETED {
            self.ctrl[slot] = EMPTY
            self.deleted -= 1
            slot = (slot + capacity - 1) & (capacity - 1)
        }
        true
    }

    // Moves the entries to fresh slots for `needed` of them: the same
    // number when they fill at most half, else the fewest that hold them
    // and more than the current ones. Every tombstone is dropped.
    fn try_grow(mut self, _ needed: usize) -> bool {
        let full = max_load(self.ctrl.len())
        var capacity = self.ctrl.len()
        if needed > full / 2 {
            capacity = MIN_CAPACITY
            while max_load(capacity) < needed || max_load(capacity) <= full {
                capacity *= 2
            }
        }
        let Option::Some(var ctrl) = MemArray::try_from_fn(capacity, |_| EMPTY) else { return false }
        let Option::Some(var keys) = MemArray::try_from_fn(capacity, |_| K::default()) else { return false }
        let Option::Some(var values) = MemArray::try_from_fn(capacity, |_| V::default()) else { return false }
        for slot in 0..self.ctrl.len() {
            let fingerprint = self.ctrl[slot]
            if fingerprint != EMPTY && fingerprint != DELETED {
                let key = self.keys[slot]
                let to = empty_slot(ctrl, key.hash())
                ctrl[to] = fingerprint
                keys[to] = key
                values[to] = self.values[slot]
            }
        }
        self.ctrl = ctrl
        self.keys = keys
        self.values = values
        self.deleted = 0
        true
    }
}

#[test]
fn swisstable_hash_reference_vectors() {
    // `folded_multiply` over 128-bit products, computed independently.
    core::assert(hash_u256(0) == 0xe0a7e05b32ab24b6)
    core::assert(hash_u256(1) == 0x7fba99af9d58edc9)
    core::assert(hash_u256(1 << 64) == 0xc320d13399174840)
    core::assert(hash_u256(1 << 128) == 0xbb7549e3223197aa)
    core::assert(hash_u256(1 << 192) == 0xbe42ec3b709f5d00)
    core::assert(hash_u256(1 << 255) == 0x4eb05caf2ed07349)
    core::assert(
        hash_u256(
                0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
            )
            == 0xa0b88a029900681b,
    )
    core::assert(
        hash_u256(
                0x1f1e1d1c1b1a191817161514131211100f0e0d0c0b0a09080706050403020100,
            )
            == 0x5ddf4b116554d203,
    )
}

#[test]
fn swisstable_hash_distributes_each_limb() {
    var shift: u256 = 0
    while shift < 256 {
        var groups: [usize; 16] = [0; 16]
        var fingerprints: [bool; 128] = [false; 128]
        var distinct: usize = 0
        var i: u256 = 0
        while i < 256 {
            let hash = hash_u256(i << shift)
            groups[home_slot(hash, 256) / 16] += 1
            let fingerprint = h2(hash) as usize
            if !fingerprints[fingerprint] {
                fingerprints[fingerprint] = true
                distinct += 1
            }
            i += 1
        }
        for count in groups {
            core::assert(count >= 4 && count <= 32)
        }
        core::assert(distinct >= 96)
        shift += 64
    }
}

// Deliberately collide in one slot to exercise wraparound and equality.
struct CollidingKey { value: u256 }
impl Copy for CollidingKey {}
impl Default for CollidingKey {
    fn default() -> Self {
        CollidingKey { value: 0 }
    }
}
impl SwissKey for CollidingKey {
    fn hash(self) -> u64 {
        240
    }
    fn equals(self, _ other: Self) -> bool {
        self.value == other.value
    }
}

#[test]
fn swisstable_collisions_updates_and_churn() {
    let count: u256 = 300
    var table = SwissTable<CollidingKey, u256>::empty()
    var i: u256 = 0
    while i < count {
        core::assert(table.try_insert(CollidingKey { value: i }, i + 1))
        i += 1
    }
    core::assert(table.len() == 300 && table.capacity() == 1024)
    // A tombstone before an existing key must not create a duplicate on update.
    core::assert(table.remove(CollidingKey { value: 0 }))
    table.insert(CollidingKey { value: 255 }, 999)
    core::assert(table.len() == 299)
    core::assert(table.get(CollidingKey { value: 255 }).value == 999)
    table.insert(CollidingKey { value: 0 }, 1)
    table.insert(CollidingKey { value: 255 }, 256)

    var generation: u256 = 0
    while generation < 4 {
        i = 0
        while i < count {
            let old = generation * count + i
            let new = old + count
            core::assert(table.get(CollidingKey { value: old }).value == old + 1)
            core::assert(table.remove(CollidingKey { value: old }))
            core::assert(!table.remove(CollidingKey { value: old }))
            core::assert(!table.contains(CollidingKey { value: old }))
            table.insert(CollidingKey { value: new }, new + 1)
            core::assert(table.len() == 300)
            i += 1
        }
        generation += 1
    }
    // Churn drops tombstones without growing.
    core::assert(table.capacity() == 1024)
    i = 0
    while i < count {
        let key = generation * count + i
        core::assert(table.get(CollidingKey { value: key }).value == key + 1)
        core::assert(table.remove(CollidingKey { value: key }))
        i += 1
    }
    core::assert(table.is_empty())
    core::assert(!table.contains(CollidingKey { value: 5000 }))
    table.insert(CollidingKey { value: 5000 }, 17)
    core::assert(table.get(CollidingKey { value: 5000 }).value == 17)
}

#[test]
fn swisstable_basic_operations() {
    var table = SwissTable<u256, u256>::empty()
    core::assert(table.is_empty())
    core::assert(table.capacity() == 0)
    core::assert(table.len() == 0)
    core::assert(!table.contains(17))
    core::assert(!table.remove(17))

    table.insert(17, 99)
    core::assert(table.len() == 1 && table.capacity() == MIN_CAPACITY)
    let first = table.get(17)
    core::assert(first.found)
    core::assert(first.value == 99)

    table.insert(17, 123)
    core::assert(table.len() == 1)
    let updated = table.get(17)
    core::assert(updated.found)
    core::assert(updated.value == 123)

    core::assert(table.remove(17))
    core::assert(table.len() == 0)
    core::assert(!table.remove(17))
    core::assert(!table.get(17).found)
}

#[test]
fn swisstable_values_change_in_place_at_found_slots() {
    var table = SwissTable<u256, u256>::empty()
    core::assert(table.find(5).is_none())
    for key in 0..40 { table.insert(key as u256, key as u256) }
    core::assert(table.find(40).is_none())
    let slot = table.find(17).unwrap()
    core::assert(table.value_at(slot) == 17)
    let value = mut table.value_at(slot)
    value += 100
    core::assert(table.get(17).value == 117 && table.len() == 40)
    // Removing other keys leaves the slot in place.
    for key in 0..10 { core::assert(table.remove(key as u256)) }
    core::assert(table.find(17) == Option::Some(slot) && table.value_at(slot) == 117)
}

#[test]
fn swisstable_find_or_insert_adds_defaults_once() {
    var table = SwissTable<u256, u256>::empty()
    for key in 0..40 {
        let slot = table.try_find_or_insert(key as u256).unwrap()
        core::assert(table.value_at(slot) == 0)
        let value = mut table.value_at(slot)
        value = key as u256 * 3
    }
    core::assert(table.len() == 40)
    // A present key keeps its value and adds nothing.
    let slot = table.try_find_or_insert(7).unwrap()
    core::assert(table.value_at(slot) == 21 && table.len() == 40 && table.find(7) == Option::Some(slot))
    for key in 0..40 { core::assert(table.get(key as u256).value == key as u256 * 3) }
}

#[test]
fn swisstable_grows_and_keeps_every_entry() {
    var table = SwissTable<u256, u256>::empty()
    var i: u256 = 0
    while i < 5000 {
        let key = i.wrapping_mul(257) + 11
        table.insert(key, key + 1000)
        // Entries and tombstones fill at most half of the slots.
        core::assert(table.len() <= table.capacity() / 2)
        i += 1
    }
    core::assert(table.len() == 5000 && table.capacity() == 16384)
    i = 0
    while i < 5000 {
        let key = i.wrapping_mul(257) + 11
        let lookup = table.get(key)
        core::assert(lookup.found && lookup.value == key + 1000)
        core::assert(!table.contains(key + 1))
        i += 1
    }
}

#[test]
fn swisstable_reserves_room() {
    var table = SwissTable<u256, u256>::empty()
    core::assert(table.try_reserve(100))
    let capacity = table.capacity()
    core::assert(capacity == 256)
    var i: u256 = 0
    while i < 100 {
        core::assert(table.try_insert(i, i))
        i += 1
    }
    core::assert(table.capacity() == capacity)
}

#[test]
fn swisstable_removal_reclaims_slots() {
    var table = SwissTable<u256, u256>::empty()
    var round: u256 = 0
    while round < 64 {
        var i: u256 = 0
        while i < 100 {
            table.insert(round * 100 + i, i)
            i += 1
        }
        i = 0
        while i < 100 {
            core::assert(table.remove(round * 100 + i))
            i += 1
        }
        round += 1
    }
    // Emptying the table frees every slot, so churn never grows it.
    core::assert(table.is_empty() && table.capacity() == 256)
    var slot: usize = 0
    while slot < table.capacity() {
        core::assert(!table.entry(slot).occupied)
        slot += 1
    }
}

#[test]
fn swisstable_entries_visit_each_live_key_once() {
    var table = SwissTable<u256, u256>::empty()
    var i: u256 = 0
    while i < 40 {
        table.insert(i * 7, i)
        i += 1
    }
    i = 0
    while i < 40 {
        if i % 3 == 0 { core::assert(table.remove(i * 7)) }
        i += 1
    }
    var seen: [bool; 40] = [false; 40]
    var count: usize = 0
    var slot: usize = 0
    while slot < table.capacity() {
        let entry = table.entry(slot)
        if entry.occupied {
            let index: usize = (entry.key / 7).downcast_unchecked()
            core::assert(entry.key % 7 == 0 && index % 3 != 0 && !seen[index])
            core::assert(entry.value == index as u256)
            seen[index] = true
            count += 1
        }
        slot += 1
    }
    core::assert(count == table.len() && count == 26)
}

#[test]
fn swisstable_clear_keeps_slots_and_forgets_entries() {
    var table = SwissTable<u256, u256>::empty()
    var key: u256 = 0
    while key < 40 {
        table.insert(key, key * 3)
        key += 1
    }
    core::assert(table.remove(7))
    let capacity = table.capacity()
    table.clear()
    core::assert(table.len() == 0 && table.capacity() == capacity)
    core::assert(!table.contains(0) && !table.contains(39) && !table.get(7).found)
    table.insert(5, 11)
    core::assert(table.len() == 1 && table.get(5).value == 11 && !table.contains(6))
    table.clear()
    table.clear()
    core::assert(table.len() == 0 && table.capacity() == capacity)
}
